# 大模型复核（可选）。不配置这一项，产品仍可完整运行，只是没有 LLM 增强。
# 任何 OpenAI 兼容端点都可以：DeepSeek / 通义千问 / 豆包 / 本地 vLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 调用参数
LLM_TIMEOUT=45           # 单次请求超时（秒）
LLM_RETRIES=2            # 429/5xx/网络错误的重试次数，指数退避
LLM_CONCURRENCY=4        # 并发复核数
LLM_TEMPERATURE=0.2
LLM_MAX_ITEMS=12         # 最多复核多少个审查点（按严重度取前 N）

# prompt 版本，对应 data/prompts/{name}.system.txt 与 {name}.user.txt
LLM_PROMPT=review_v1

# 设为 1 可强制关闭大模型，退回纯规则模式
# LLM_DISABLE=0
